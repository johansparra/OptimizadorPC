{"nodes": [{"id": "tests_readme_test_suite", "label": "Pruebas \u2014 test suite (Run-Tests.ps1, no Pester)", "file_type": "document", "source_file": "tests/README.md", "source_location": "L1-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Pester: Windows ships only 3.4 with old syntax, so using it would require Install-Module; TestKit.ps1 does the job. Folders Harness/Core/Ui/Source; new *.Tests.ps1 are picked up automatically. ~587 tests per host."}, {"id": "tests_readme_both_hosts", "label": "Run tests on both hosts (-BothHosts)", "file_type": "rationale", "source_file": "tests/README.md", "source_location": "L9-11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exe runs on 5.1 with everything in global scope; main.ps1 runs on pwsh 7 in script scope; some failures appear in only one (CLAUDE.md rule 8)."}, {"id": "tests_readme_testkit", "label": "Harness/TestKit.ps1 (Describe/It/Assert)", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_readme_apphost", "label": "Harness/AppHost.ps1", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L43, L97-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loads the app without a window, redirects settings.json, disarms registry writes and command execution, loads guides via the main.ps1 marker, behaves elevated. Reads main.ps1 with the same regexes as build.ps1 so tests load exactly what ships and validate the packaging contract."}, {"id": "tests_readme_fixtures", "label": "Harness/Fixtures.ps1 (HKCU test branch per PID)", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_readme_find_visuals", "label": "Find-Visuals (do not wrap in @())", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L82-89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ends with ', $found.ToArray()' so the array arrives whole; @() nests it and member enumeration silently concatenates texts. Stack-based, order not guaranteed: assert by content, not index."}, {"id": "tests_readme_wiring_tests", "label": "Ui/Wiring.Tests.ps1", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L91-95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main.ps1 ends in ShowDialog(), so a copy without it plus scripted clicks runs in another process of the same host; the only way to catch rule 4 (closure handler failing on click)."}, {"id": "tests_readme_playwright", "label": "Playwright (not applicable to WPF)", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L101-106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automates browsers via DevTools and DOM selectors; WPF has no DOM. Same for Cypress, Selenium, Puppeteer."}, {"id": "tests_readme_ui_automation", "label": "UI Automation (System.Windows.Automation / FlaUI / WinAppDriver)", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L108-144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not needed yet: tests build real WPF controls without showing the window. Worth it only for real hit-testing, IsHitTestVisible, finished animations and an exe smoke test."}, {"id": "tests_readme_exe_smoke_test", "label": "Pending smoke test of compiled .exe", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L137-144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matters more now that a click writes HKLM as admin; still pending due to maintenance cost, writes covered at core/ level against an HKCU test branch."}, {"id": "tests_readme_not_covered", "label": "What the tests do not cover", "file_type": "concept", "source_file": "tests/README.md", "source_location": "L146-163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appearance, the running exe, a real mouse, real HKLM writes, elevation, and real commands (only netsh interface show interface runs; cleanup on a fake folder; never recycle bin, powercfg or DISM)."}], "edges": [{"source": "tests_readme_test_suite", "target": "security_seguridad_optimizador_pc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/README.md", "source_location": "L75", "weight": 1.0}, {"source": "tests_readme_test_suite", "target": "tests_run_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/README.md", "source_location": "L41", "weight": 1.0}, {"source": "tests_readme_test_suite", "target": "tests_readme_both_hosts", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/README.md", "source_location": "L9", "weight": 1.0}, {"source": "tests_readme_test_suite", "target": "tests_readme_testkit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/README.md", "source_location": "L25", "weight": 1.0}, {"source": "tests_readme_test_suite", "target": "tests_readme_apphost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/README.md", "source_location": "L43", "weight": 1.0}, {"source": "tests_readme_test_suite", "target": "tests_readme_fixtures", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/README.md", "source_location": "L44", "weight": 1.0}, {"source": "tests_readme_test_suite", "target": "tests_r