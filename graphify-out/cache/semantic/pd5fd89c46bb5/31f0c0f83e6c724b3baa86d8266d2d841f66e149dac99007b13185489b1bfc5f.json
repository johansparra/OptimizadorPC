{"nodes": [{"id": "claude", "label": "CLAUDE.md (OptimizadorPC)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_layered_architecture", "label": "Arquitectura en 7 capas (Design, Engine, Index, core, Data, Components, Views)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nunca saltar una capa hacia abajo; core/ no conoce la interfaz; el orden de carga solo importa porque los datos se registran al cargarse."}, {"id": "claude_embed_markers", "label": "Marcadores de build.ps1 (@@EMBED_DIR, @@EMBED_GUIDES, @@EMBED_XAML)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ps2exe acepta un solo archivo; cualquier .ps1 cargado a mano fuera de las 7 carpetas funcionaria en desarrollo y fallaria compilado."}, {"id": "claude_utf8_bom_rule", "label": "Regla: .ps1/.xaml en UTF-8 con BOM", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows PowerShell 5.1 lee un script sin BOM como ANSI y el parser falla con mojibake."}, {"id": "claude_no_getnewclosure_rule", "label": "Regla: no usar .GetNewClosure() en handlers", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El closure liga el scriptblock a un modulo dinamico donde las funciones del script son invisibles; pasar datos por Tag."}, {"id": "claude_both_hosts_rule", "label": "Regla: probar siempre en ambos hosts (5.1 y 7)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "