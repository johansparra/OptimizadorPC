{"nodes": [{"id": "claude_optimizador_pc", "label": "Optimizador PC (CLAUDE.md)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_layer_architecture", "label": "Layered architecture (7 layer folders)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never skip a layer downward; folder name dictates contents. Load order matters only because data registers itself on load (Register-Category lives in ui/Engine)."}, {"id": "claude_embed_dir_marker", "label": "@@EMBED_DIR / @@EMBED_XAML build markers", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L176", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ps2exe accepts one input file; build.ps1 inlines whole layer folders recursively. No way to include a loose file: a manual dot-source works in dev and fails compiled."}, {"id": "claude_utf8_bom_rule", "label": "UTF-8 with BOM rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows PowerShell 5.1 reads BOM-less scripts as Windows-1252, causing mojibake and parse errors; pwsh 7 does not, so files can pass in 7 and break in 5.1."}, {"id": "claude_no_getnewclosure_rule", "label": "No .GetNewClosure() in event handlers", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closures bind to a dynamic module where script functions are invisible; only fails running main.ps1, not the .exe. Pass data via control Tag and get the window from sender."}, {"id": "claude_two_hosts_rule", "label": "Test in both hosts (PS 5.1 exe and pwsh 7 main.ps1)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .exe runs in global scope under 5.1 and main.ps1 in script scope under 7; some bugs appear only in one."}, {"id": "claude_theme_resource_colors", "label": "Theme-resource colors (Set-TextFg / Set-BoxBg / DynamicResource)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L197", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Literal #RRGGBB does not change on light/dark toggle; three distinct background properties are not interchangeable."}, {"id": "claude_frozen_brushes", "label": "Frozen brushes (Set-AppTheme, Resources.Add)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L204", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WPF freezes shareable SolidColorBrushes on XAML load; indexer stores a PSObject wrapper that WPF rejects, so Resources.Add() is used."}, {"id": "claude_glyph_catalog", "label": "Glyph catalog (Segoe Fluent Icons)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L206", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_sidebar_by_code", "label": "Sidebar built by code (Build-Sidebar, Set-NavSelection, Sync-NavSelection)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entry without View does not navigate on purpose so the menu never marks one thing while showing another; selection decided in Show-View since screens can be reached without the menu."}, {"id": "claude_translation_t", "label": "Translation via T (source-text keyed)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L215", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A literal without T stays English and is invisible to Get-MissingTranslations; language change requires repaint via Update-UiLanguage because text has no DynamicResource."}, {"id": "claude_router_show_view", "label": "Router / Show-View", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calling views directly loses router state so language change repaints the wrong screen."}, {"id": "claude_app_settings", "label": "Set-AppSetting / settings.json in %APPDATA%", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L218", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Portable exe may live in a non-writable folder; corrupt JSON ignored."}, {"id": "claude_list_object_pitfall", "label": "@() over List[object] pitfall (use .ToArray())", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L219", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_hover_lift_wrapper", "label": "Add-HoverLift static wrapper (RenderTransform hit-test loop)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L236", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RenderTransform also moves the hit zone, causing an infinite MouseEnter/Leave loop; the listener must be a stationary wrapper."}, {"id": "claude_staggered_enter", "label": "Start-StaggeredEnter / Get-EnterTarget", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L253", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_gradient_tokens", "label": "Get-Palette and $GradientTokens (two color families)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each gradient is composed from two palette keys so no color is written twice; Get-GradientKey falls back to the flat key."}, {"id": "claude_backdrop_20fps", "label": "Live backdrop at 20 fps without BlurEffect", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L270", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nobody distinguishes 20 vs 60 fps on a 30s path; radial gradients fade to transparent instead of expensive blur. An app named Optimizador PC must not waste CPU."}, {"id": "claude_mica_exclusive", "label": "Mica and custom gradient are mutually exclusive", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L278", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System material only shows through a translucent window, which cannot have its own background; dwmapi call never throws and falls back to opaque."}, {"id": "claude_tests_isolation", "label": "Tests do not write user settings (AppHost redirects $AppSettingsPath)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L286", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_test_suite", "label": "Test suite (tests/Run-Tests.ps1 -BothHosts, no Pester)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows ships Pester 3.4, incompatible with modern syntax; harness is dependency-free."}, {"id": "claude_encoding_hook", "label": "Normalize-PsEncoding PostToolUse hook", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook lives in OptimizadorPC/.claude/settings.local.json and is not loaded when the session opens from the parent folder."}, {"id": "claude_graphify_graph_limits", "label": "graphify graph: uses and limits", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No edge connects code to documentation, so natural-language queries return doc nodes and miss code; use path/explain on code symbols only, and refresh with --update."}, {"id": "claude_delegation_policy", "label": "Agent delegation policy", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents start cold; delegate only with two or more independent fronts, launched in parallel."}, {"id": "claude_registry_status", "label": "Computed registry status (optimized/factory/custom/unknown)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L340", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status is computed where it is read (Update-CategoryRegistryState), not where painted; a setting with -Registry carries no -Tags since they'd be the invented version of the same thing."}, {"id": "claude_core_never_throws", "label": "core/ never throws upward (read/missing/denied/badpath)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L336", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An exception escaping core would bring down the window; missing/denied keys are answers, not errors."}, {"id": "claude_dword_signed", "label": "DWord arrives as signed Int32 (Format-RegistryValue)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L337", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_registry64_view", "label": "Always RegistryView::Registry64", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L338", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 32-bit build would silently redirect HKLM\\SOFTWARE to Wow6432Node."}, {"id": "claude_activity_log", "label": "Activity log (core/Diagnostics/Log.ps1, LogPanel, LogWindow)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L345", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Log stores facts not phrases so core stays language-agnostic; log lines intentionally untranslated; save dialog split in three because a modal cannot be tested; new lines need Sync-LogView since core does not notify UI."}, {"id": "claude_update_ui_now_doevents", "label": "Update-UiNow is a DoEvents (disable hit-testing during reads)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L418", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_global_search", "label": "Global search (flat index, Reset-SearchIndex, New-SearchBar)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L420", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indexes translated and original text; translate before joining; repaint body never header to keep focus; popup reopen deferred via Dispatcher to avoid StaysOpen flicker; [action] does not capture locals so box travels via $script:SearchReopenBox."}], "edges": [{"source": "claude_optimizador_pc", "target": "readme_optimizador_pc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L3", "weight": 1.0}, {"source": "claude_optimizador_pc", "target": "security_threat_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L16", "weight": 1.0}, {"source": "claude_optimizador_pc", "target": "claude_layer_architecture", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L24", "weight": 1.0}, {"source": "claude_layer_architecture", "target": "claude_embed_dir_marker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L48", "weight": 1.0}, {"source": "claude_two_hosts_rule", "target": "claude_no_getnewclosure_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L184", "weight": 1.0}, {"source": "claude_two_hosts_rule", "target": "claude_utf8_bom_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L183", "weight": 1.0}, {"source": "claude_encoding_hook", "target": "claude_utf8_bom_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L116", "weight": 1.0}, {"source": "claude_test_suite", "target": "claude_two_hosts_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L77", "weight": 1.0}, {"source": "claude_tests_isolation", "target": "claude_app_settings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L286", "weight": 1.0}, {"source": "claude_tests_isolation", "target": "claude_test_suite", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": "L286", "weight": 1.0}, {"source": "claude_frozen_brushes", "target": "claude_theme_resource_colors", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUD