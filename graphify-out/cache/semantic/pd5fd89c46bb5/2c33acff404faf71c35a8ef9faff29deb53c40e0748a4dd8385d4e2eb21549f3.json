{"nodes": [{"id": "ui_data_guides_nic_i211_gaming_tweaks_guide", "label": "Guide: Intel I211 NIC advanced properties for gaming (BF6)", "file_type": "document", "source_file": "ui/Data/Guides/nic_i211_gaming_tweaks.md", "source_location": "L1-38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapter Advanced-tab values for a specific machine (I211, Ryzen 5800XT): wake/power features off, buffers max, jumbo off, speed fixed 1 Gbps full duplex; change one at a time."}, {"id": "ui_data_guides_nic_i211_gaming_tweaks_interrupt_moderation", "label": "Interrupt Moderation disabled", "file_type": "concept", "source_file": "ui/Data/Guides/nic_i211_gaming_tweaks.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batching interrupts adds packet latency; extra interrupts are negligible on a modern CPU."}, {"id": "ui_data_guides_nic_i211_gaming_tweaks_energy_efficient_ethernet", "label": "Energy Efficient Ethernet (EEE / Green Ethernet) disabled", "file_type": "concept", "source_file": "ui/Data/Guides/nic_i211_gaming_tweaks.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Link wake-ups add intermittent jitter; classic cause of random ping spikes."}, {"id": "ui_data_guides_nic_i211_gaming_tweaks_large_send_offload", "label": "Large Send Offload V2 (IPv4/IPv6) disabled", "file_type": "concept", "source_file": "ui/Data/Guides/nic_i211_gaming_tweaks.md", "source_location": "L22-23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouping large segments adds latency."}, {"id": "ui_data_guides_nic_i211_gaming_tweaks_flow_control", "label": "Flow Control disabled", "file_type": "concept", "source_file": "ui/Data/Guides/nic_i211_gaming_tweaks.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "ra