{"nodes": [{"id": "claude_optimizador_pc", "label": "Optimizador PC (WPF on PowerShell 5.1)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "## Qu\u00e9 es", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_layer_architecture", "label": "Seven-layer architecture (Design/Engine/Index/core/Data/Components/Views)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "## Arquitectura", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never jump a layer downward; load order matters only because data registers itself on load (ui/Data/Categories calls Register-Category in ui/Engine)."}, {"id": "claude_embed_dir_markers", "label": "@@EMBED_DIR / @@EMBED_XAML build markers", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Regla 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ps2exe accepts one input file; loading a file by hand works in dev but fails in the compiled .exe, so every .ps1 must live inside one of the seven embedded folders."}, {"id": "claude_utf8_bom_rule", "label": "UTF-8 with BOM rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows PowerShell 5.1 reads BOM-less scripts as ANSI, producing mojibake and parser errors that pwsh 7 does not show."}, {"id": "claude_no_getnewclosure_rule", "label": "No .GetNewClosure() in event handlers (pass data via Tag)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closures bind to a dynamic module where script functions are invisible; only visible running main.ps1, not the .exe."}, {"id": "claude_two_hosts_rule", "label": "Test on both hosts (5.1 .exe and pwsh 7 main.ps1)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .exe runs in global scope under 5.1 and main.ps1 in script scope under 7; some bugs only appear in one."}, {"id": "claude_theme_resources_rule", "label": "Colors via theme resources (DynamicResource / Set-TextFg)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Literal #RRGGBB does not change when toggling light/dark."}, {"id": "claude_frozen_brushes", "label": "Frozen brushes / Set-AppTheme", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Regla 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WPF freezes shareable brushes on XAML load; replace via Resources.Add() because the indexer stores a PSObject wrapper WPF rejects."}, {"id": "claude_glyph_catalog", "label": "Glyph catalog (Segoe Fluent Icons in Theme.ps1)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Regla 12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_sidebar_navigation", "label": "Sidebar built in code from NavigationIndex", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Reglas 13-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An entry without View does not navigate; never route to a filler view or menu and screen would disagree. Animate Border width, not Grid column."}, {"id": "claude_translation_t", "label": "Translation function T (source-text keyed)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Reglas 15-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A literal without T stays English and is invisible to Get-MissingTranslations; text must be repainted on language change since there is no DynamicResource for text."}, {"id": "claude_router_show_view", "label": "Router / Show-View", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Regla 17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_app_settings", "label": "Set-AppSetting / settings.json in %APPDATA%", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Regla 18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The portable .exe may live in a non-writable folder; corrupt JSON is ignored."}, {"id": "claude_hover_lift", "label": "Add-HoverLift stationary wrapper", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Reglas 21, 24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RenderTransform moves the hit-test area, causing MouseEnter/Leave loops; the listener must be a stationary wrapper, and staggered enter moves the inner card (Get-EnterTarget)."}, {"id": "claude_gradient_tokens", "label": "$GradientTokens composed from palette keys", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Regla 23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_backdrop_20fps", "label": "Live backdrop at 20 fps without BlurEffect", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nobody distinguishes 20 from 60 fps on a 30s motion; a program called Optimizador PC should not repaint constantly; radial gradient to transparent avoids expensive blur."}, {"id": "claude_mica_exclusive", "label": "Mica/Acrylic exclusive with own gradient", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System material only shows on translucent windows which cannot have their own background; dwmapi call never throws and falls back to opaque."}, {"id": "claude_tests_dont_write_settings", "label": "Tests redirect $AppSettingsPath", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Regla 28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without redirection tests would overwrite the user's settings.json with only the key they touched."}, {"id": "claude_graphify_limitations", "label": "graphify graph usage limits", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "### El grafo de graphify", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No edge connects code to documentation, so natural-language queries return doc nodes and miss code; use path/explain on code symbols only, and refresh with --update."}, {"id": "claude_registry_setting_status", "label": "Computed setting Status (optimized/factory/custom/unknown)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "## Al implementar tweaks reales", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A setting with -Registry has no -Tags: tags would be an invented version of the same fact. Missing value is factory; nothing to compare is unknown, never custom."}, {"id": "claude_core_never_throws", "label": "core/ never throws upward", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "## Al implementar tweaks reales", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An exception escaping core/ would bring down the window; return states read/missing/denied/badpath instead."}, {"id": "claude_status_filter", "label": "Summary pills as status filter", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "## Al implementar tweaks reales", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_command_steps_sections", "label": "Command-step sections (Internet)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "## Las secciones de comandos", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Execution order is the file order since steps depend on each other; a DispatcherTimer ticks every 120 ms doing one thing per tick so the window never freezes."}, {"id": "claude_activity_log", "label": "Activity log (core/Diagnostics/Log.ps1 + LogPanel/LogWindow)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "## El registro de actividad", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Log stores facts not phrases so core/ stays language-agnostic; log lines are intentionally untranslated technical text; save dialog split in three because a modal cannot be tested."}, {"id": "claude_update_uinow_doevents", "label": "Update-UiNow as DoEvents", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "## El registro de actividad", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yields the thread so the progress bar paints; window must be made hit-test-deaf to avoid navigation mid-read."}, {"id": "claude_global_search", "label": "Global search (flat index, ui/Engine/Search.ps1)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "## El buscador global", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indexes both translated and original text; repaint body not header to keep focus; reopen popup via GotFocus plus PreviewMouseLeftButtonDown and defer opening with Dispatcher.BeginInvoke to avoid flicker."}], "edges": [{"source": "claude_optimizador_pc", "target": "r